# 이 파일을 복사해 .env 를 만들고 값을 채운다. (.env 는 gitignore 처리됨)

# 로컬은 SQLite, 배포 시 Supabase/PostgreSQL 연결 문자열로 교체
DATABASE_URL=sqlite:///./poom.db

# mock = LLM 없이 동작(테스트·시연 폴백) / openai = 실제 모델 연결
LLM_PROVIDER=mock

# 백엔드 B: 실제 키는 여기에 넣되, .env 파일 자체를 커밋하지 말 것
OPENAI_API_KEY=

# CORS 허용 오리진(프론트 배포 도메인). 로컬 개발용 http://localhost:3000 은
# 코드에 이미 포함돼 있으므로, 배포 후 추가되는 도메인만 여기에 넣는다.
# 예: FRONTEND_ORIGIN=https://poom.vercel.app
FRONTEND_ORIGIN=
