# 이 파일을 복사해 .env 를 만들고 값을 채운다. (.env 는 gitignore 처리됨)

# 로컬은 SQLite, 배포 시 Supabase/PostgreSQL 연결 문자열로 교체
DATABASE_URL=sqlite:///./poom.db

# mock = LLM 없이 동작(테스트·시연 폴백) / openai = 실제 모델 연결
LLM_PROVIDER=mock

# 백엔드 B: 실제 키는 여기에 넣되, .env 파일 자체를 커밋하지 말 것
OPENAI_API_KEY=

# CORS 허용 오리진(프론트 배포 도메인). 로컬 개발용 http://localhost:3000 과
# http://localhost:5173(Vite)은 코드에 이미 포함돼 있으므로,
# 배포 후 추가되는 도메인만 여기에 넣는다.
# 예: FRONTEND_ORIGIN=https://poom.vercel.app
FRONTEND_ORIGIN=

# 데모 라우터(/api/v1/demo/*) 보호 키.
# 설정하면 해당 엔드포인트가 X-Demo-Key 헤더 일치를 요구한다(불일치·부재 시 403).
# 비워 두면 무인증 — 로컬 개발·테스트는 이대로 쓰고, 배포 환경에는 반드시 설정한다.
DEMO_KEY=
